# ─────────────────────────────────────────────────────────────────────────────
# HealthLifeHub Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Server
# On Replit, PORT is set automatically — do NOT change it here.
PORT=3000
NODE_ENV=development

# Database — SQLite local file (no external service needed)
# The file lives at backend/prisma/dev.db
DATABASE_URL="file:./prisma/dev.db"

# ─── JWT Secret ───────────────────────────────────────────────────────────────
# Make up any long random string — keep it private, never share it
JWT_SECRET="your-super-secret-jwt-key-change-this"

# ─── Google AI (Gemini) ───────────────────────────────────────────────────────
# Get your FREE key at: https://aistudio.google.com/app/apikey
# One key powers: AI coach, food photo recognition, nutrition data, recipes
GOOGLE_API_KEY="AIza..."

# CORS — allowed origins for the mobile app
ALLOWED_ORIGINS="http://localhost:8081,exp://localhost:8081"
