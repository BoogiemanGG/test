# ─────────────────────────────────────────────────────────────────────────────
# HealthLifeHub Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Database (Supabase PostgreSQL connection string)
DATABASE_URL="postgresql://user:password@db.supabase.co:5432/healthlifehub"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:8081,exp://localhost:8081"

# ─── AI / Claude API ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Food Recognition ─────────────────────────────────────────────────────────
GOOGLE_VISION_API_KEY="AIza..."

# ─── Nutrition Data ───────────────────────────────────────────────────────────
# Get free keys at: https://developer.edamam.com
EDAMAM_APP_ID="your-edamam-app-id"
EDAMAM_APP_KEY="your-edamam-app-key"

# ─── Recipe Database ─────────────────────────────────────────────────────────
# Get free key at: https://spoonacular.com/food-api
SPOONACULAR_API_KEY="your-spoonacular-key"

# ─── Storage (for photos) ────────────────────────────────────────────────────
# Cloudflare R2 (cheaper than AWS S3)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret"
R2_BUCKET_NAME="healthlifehub-photos"
R2_PUBLIC_URL="https://your-r2-public-url.r2.dev"
